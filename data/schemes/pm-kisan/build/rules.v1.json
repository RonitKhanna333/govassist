      "pdf": "source/operational-guidelines.pdf",
      "retrieved_at": "2026-11-25",
      "txt": "source/operational-guidelines.txt",
      "url": "https://pmkisan.gov.in/Documents/RevisedPM-KISANOperationalGuidelines(English).pdf"
    }
  ],
  "tier": 1,
  "version": 1
}
