# Copy to .env and fill in. Never commit the real .env -- it's gitignored.
#
# Nothing here is required to run the rule engine, the graph, or the test
# suite. Each key unlocks one capability, and the system degrades honestly
# without it rather than crashing:

# --- Groq: composes and verifies the explanation -------------------------
# Without it, verdicts and citations still work; the `answer` field falls
# back to "I don't have grounded facts to explain this with".
# Free key, no card: https://console.groq.com
GROQ_API_KEY=

# --- Bhashini / ULCA: Indic translation, TTS, ASR ------------------------
# Without these, the UI still runs in all four languages (the interface
# catalogs are static), but answers stay in English with a visible note
# saying why, and speech falls back to the browser's own voices.
# Free for non-commercial use: https://bhashini.gov.in
ULCA_USER_ID=
ULCA_API_KEY=
BHASHINI_INFERENCE_KEY=

# --- Database ------------------------------------------------------------
# Unset -> a local SQLite file, which is correct for dev and CI.
# For Vercel, use a POOLED connection string (Neon's "-pooler" host).
# A direct connection will exhaust Postgres connection slots under
# serverless cold starts.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/govassist?sslmode=require

# --- CORS ----------------------------------------------------------------
# Comma-separated origins allowed to call the API. Defaults to localhost:3000.
# *.vercel.app preview subdomains are matched by regex and need no entry.
# CORS_ORIGINS=https://govassist-web-ronit-khannas-projects.vercel.app

# --- Auth ----------------------------------------------------------------
# Signing key for session tokens. No default, deliberately: a fallback baked
# into this public repo would let anyone mint a token for any account.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
